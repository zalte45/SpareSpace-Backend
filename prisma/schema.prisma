
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  pending
  confirmed
  active
  completed
  cancelled
  expired
}

enum PaymentStatus {
  pending
  successful
  failed
  refunded
}

model Booking {
  id              Int           @id @default(autoincrement())

  renterId        String
  listingId       String
  hostId          String

  startDate       DateTime
  endDate         DateTime

  monthlyPrice    Decimal       @db.Decimal(10, 2)
  securityDeposit Decimal       @default(0) @db.Decimal(10, 2)
  platformFee     Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)

  durationMonths  Int

  bookingStatus   BookingStatus @default(confirmed)
  paymentStatus   PaymentStatus @default(pending)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([renterId])
  @@index([listingId])
  @@index([hostId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([listingId, startDate, endDate])
}
