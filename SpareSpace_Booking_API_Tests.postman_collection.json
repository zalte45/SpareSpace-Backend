            "url": {
              "raw": "{{baseUrl}}/booking/{{createdBookingId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{createdBookingId}}",
                "complete"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Message indicates host-only completion', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.message).to.eql('Only the host can complete this booking');",
                  "});"
                ]
              }
            }
          ]
        },
        {
