    {
      "name": "03 Booking Creation Tests",
      "item": [
        {
          "name": "TC-BOOK-01: Create Valid Booking (Captures ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "accessToken={{tenantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"startDate\": \"{{testStartDate}}\",\n  \"endDate\": \"{{testEndDate}}\",\n  \"durationMonths\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Booking object returned with confirmed status', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.booking).to.have.property('_id');",
                  "    pm.expect(json.booking.bookingStatus).to.eql('confirmed');",
                  "    pm.expect(json.booking.paymentStatus).to.eql('pending');",
                  "    // Dynamically store booking ID for downstream tests",
                  "    pm.collectionVariables.set('createdBookingId', json.booking._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-BOOK-02: Create Overlapping Booking (Conflict Prevention)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "accessToken={{unauthorizedTenantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"startDate\": \"{{testStartDate}}\",\n  \"endDate\": \"{{testEndDate}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Response rejects overlap', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.message).to.eql('Space is already booked for the selected dates');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
